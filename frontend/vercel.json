{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://japaneseapp.onrender.com/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://japaneseapp.onrender.com/oauth2/:path*"
    },
    {
      "source": "/login-backend/:path*",
      "destination": "https://japaneseapp.onrender.com/login/:path*"
    },
    {
      "source": "/((?!api/|oauth2/|login-backend/).*)",
      "destination": "/index.html"
    }
  ]
}